<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="OTA 升级演示"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 连接状态 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="连接状态："
            android:textColor="#212121"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConnectionStatus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#F5F5F5"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="正在连接..."
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 文件选择按钮 -->
        <Button
            android:id="@+id/btnSelectFile2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="选择 OTA 文件 (.up 或 .upex)" />

        <!-- 选中的文件信息 -->
        <TextView
            android:id="@+id/tvSelectedFile2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="未选择文件"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 开始传输按钮 -->
        <Button
            android:id="@+id/btnStartTransfer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:enabled="false"
            android:text="开始传输" />

        <!-- 取消传输按钮 -->
        <Button
            android:id="@+id/btnCancelTransfer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:enabled="false"
            android:text="取消传输" />

        <!-- 传输状态 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="状态："
            android:textColor="#212121"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="等待开始..."
            android:textColor="#666666"
            android:textSize="16sp" />

        <!-- 传输进度 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="进度："
            android:textColor="#212121"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvProgress2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="0%"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 日志显示区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="日志："
            android:textColor="#212121"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="等待操作..."
                android:textColor="#333333"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OTA 升级演示"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 连接状态 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="连接状态："
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在连接..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp" />

    <!-- 文件选择按钮 -->
    <Button
        android:id="@+id/btnSelectFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择 OTA 文件 (.up 或 .upex)"
        android:layout_marginBottom="16dp" />

    <!-- 选中的文件信息 -->
    <TextView
        android:id="@+id/tvSelectedFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未选择文件"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <!-- 开始传输按钮 -->
    <Button
        android:id="@+id/btnStartTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开始传输"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- 取消传输按钮 -->
    <Button
        android:id="@+id/btnCancelTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="取消传输"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- 传输状态 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态："
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待开始..."
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <!-- 传输进度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="进度："
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginTop="8dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 日志显示区域 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="日志："
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待操作..."
            android:textSize="12sp"
            android:textColor="#333333"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
