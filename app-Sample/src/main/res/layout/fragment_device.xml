<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="?dividerVertical"
            android:orientation="vertical"
            android:showDividers="end|middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="ignoreParentState">

                <FrameLayout
                android:id="@+id/item_device_bind"
                style="@style/Widget.Sample.PreferenceBase"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="连接"
                    android:textAppearance="?textAppearanceSubtitle2"
                    app:drawableStartCompat="@drawable/ic_baseline_add_24"
                    app:drawableTint="?colorOnSurface" />

            </FrameLayout>
            <com.github.kilnn.tool.widget.item.PreferenceItem
                android:id="@+id/item_ota_sdk_demo2"
                style="@style/Widget.Sample.PreferenceView.Item.Text"
                app:preferenceTitle="OTA SDK Demo 通用设备 连接bt即可" />
            <RelativeLayout
                android:id="@+id/item_device_info"
                style="@style/Widget.Sample.PreferenceView"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_device_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/dp_10">

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?textAppearanceSubtitle1"
                        android:textColor="?android:textColorPrimary"
                        tools:text="X20-123H" />

                    <TextView
                        android:id="@+id/tv_device_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/device_state_connecting"
                        android:textAppearance="?textAppearanceCaption"
                        android:textColor="?android:textColorSecondary" />

                    <com.sjbt.sdk.sample.widget.BatteryImageView
                        android:id="@+id/battery_view"
                        android:layout_width="28dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:layout_toEndOf="@+id/layout_device_info"
                    android:background="@color/primary_danger"
                    android:paddingHorizontal="@dimen/dp_3"
                    android:text="@string/ds_device_reset"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/img_device_add"
                    android:layout_width="61dp"
                    android:layout_height="61dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@mipmap/ic_device_default" />
                <!-- android:src="@drawable/ic_baseline_add_24"
                android:padding="@dimen/dp_15"
                -->
            </RelativeLayout>
        </LinearLayout>

        <!-- 照片数量行：当设备无存储时隐藏 -->
        <LinearLayout
            android:id="@+id/layout_media_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="photo:- ,video:- ,record:- ,music:-" />

            <Button
                android:id="@+id/btn_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_count" />
        </LinearLayout>


        <!-- 存储信息行：当设备无存储时隐藏 -->
        <LinearLayout
            android:id="@+id/layout_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_store"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="used/total:" />

            <Button
                android:id="@+id/btn_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/get_count" />
        </LinearLayout>

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_device_config"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_config" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_basic_device_info"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_basic_device_info" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_device_preview"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_basic_device_preview" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_device_chat"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_basic_device_chat" />

        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_device_chat_new"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_basic_device_long_chat" />
        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_other_features"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/ds_other_features" />
        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/item_ota_sdk_demo"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="OTA SDK Demo" />


        <com.github.kilnn.tool.widget.item.PreferenceItem
            android:id="@+id/itemPhotoLibrary"
            style="@style/Widget.Sample.PreferenceView.Item.Text"
            app:preferenceTitle="@string/photo" />

        <!-- 底部操作按钮容器：当设备无存储时隐藏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <Button
                android:id="@+id/btn_take_photo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_50"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:text="@string/take_photo" />

            <Button
                android:id="@+id/btn_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:text="@string/start_video_recording" />

            <Button
                android:id="@+id/btn_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:text="@string/start_recorded" />

            <Button
                android:id="@+id/btn_custom_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:text="自定义消息" />

        </LinearLayout>

        <!-- 无存储设备提示文字：当设备无存储时显示 -->
        <TextView
            android:id="@+id/tv_storage_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_10"
            android:layout_marginVertical="@dimen/dp_16"
            android:gravity="center"
            android:textAppearance="?textAppearanceBody1"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone"
            tools:text="无存储设备" />

        </LinearLayout>
    </ScrollView>

    <!-- BLE搜索连接：固定在底部，不随内容滚动 -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />
    <com.github.kilnn.tool.widget.item.PreferenceItem
        android:id="@+id/item_ble_scan_connect"
        style="@style/Widget.Sample.PreferenceView.Item.Text"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        app:preferenceTitle="@string/ble_scan_connect" />
</LinearLayout>